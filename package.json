    "gallery:propose": "node scripts/gallery-pipeline/propose-catalog-changes.mjs",
    "gallery:portfolio": "node scripts/gallery-pipeline/generate-portfolio-report.mjs",
    "ci:gallery": "npm run gallery:test && npm run gallery:validate",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
