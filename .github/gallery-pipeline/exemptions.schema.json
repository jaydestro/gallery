{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gallery lifecycle exemptions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "exemptions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "exemptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exemption"
      }
    }
  },
  "$defs": {
    "exemption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "galleryId",
        "ruleIds",
        "owner",
        "rationale",
        "startsAt",
        "expiresAt",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "galleryId": {
          "type": "string",
          "minLength": 1
        },
        "ruleIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "startsAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "active",
            "expired",
            "revoked"
          ]
        }
      }
    }
  }
}