{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gallery trusted source registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "sources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sources": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/githubOrganization"
          },
          {
            "$ref": "#/$defs/documentationRoot"
          },
          {
            "$ref": "#/$defs/rssFeed"
          },
          {
            "$ref": "#/$defs/youtubeChannel"
          },
          {
            "$ref": "#/$defs/youtubePlaylist"
          }
        ]
      }
    }
  },
  "$defs": {
    "commonStringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "githubOrganization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "endpoint",
        "organization",
        "trustTier",
        "enabled",
        "cadence",
        "ownerLabel",
        "includeRules",
        "excludeRules"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "type": {
          "const": "github-organization"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://api\\.github\\.com/orgs/[^/]+$"
        },
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "trustTier": {
          "const": "first-party"
        },
        "enabled": {
          "type": "boolean"
        },
        "cadence": {
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "quarterly"
          ]
        },
        "ownerLabel": {
          "type": "string",
          "minLength": 1
        },
        "includeRules": {
          "$ref": "#/$defs/commonStringArray"
        },
        "excludeRules": {
          "$ref": "#/$defs/commonStringArray"
        }
      }
    },
    "documentationRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "endpoint",
        "trustTier",
        "enabled",
        "cadence",
        "ownerLabel",
        "includeRules",
        "excludeRules"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "type": {
          "const": "documentation-root"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://learn\\.microsoft\\.com/"
        },
        "trustTier": {
          "const": "first-party"
        },
        "enabled": {
          "type": "boolean"
        },
        "cadence": {
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "quarterly"
          ]
        },
        "ownerLabel": {
          "type": "string",
          "minLength": 1
        },
        "includeRules": {
          "$ref": "#/$defs/commonStringArray"
        },
        "excludeRules": {
          "$ref": "#/$defs/commonStringArray"
        }
      }
    },
    "rssFeed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "endpoint",
        "trustTier",
        "enabled",
        "cadence",
        "ownerLabel",
        "includeRules",
        "excludeRules"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "type": {
          "const": "rss-feed"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://devblogs\\.microsoft\\.com/"
        },
        "trustTier": {
          "const": "first-party"
        },
        "enabled": {
          "type": "boolean"
        },
        "cadence": {
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "quarterly"
          ]
        },
        "ownerLabel": {
          "type": "string",
          "minLength": 1
        },
        "includeRules": {
          "$ref": "#/$defs/commonStringArray"
        },
        "excludeRules": {
          "$ref": "#/$defs/commonStringArray"
        }
      }
    },
    "youtubeChannel": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "endpoint": {
              "const": "https://youtube.googleapis.com/youtube/v3"
            },
            "transport": {
              "const": "api"
            }
          }
        },
        {
          "required": [
            "transport"
          ],
          "properties": {
            "endpoint": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://www\\.youtube\\.com/feeds/videos\\.xml\\?channel_id=UC[A-Za-z0-9_-]{22}$"
            },
            "transport": {
              "const": "official-feed"
            }
          }
        }
      ],
      "required": [
        "id",
        "type",
        "endpoint",
        "channelId",
        "trustTier",
        "enabled",
        "cadence",
        "ownerLabel",
        "includeRules",
        "excludeRules"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "type": {
          "const": "youtube-channel"
        },
        "endpoint": {
          "type": "string",
          "format": "uri"
        },
        "channelId": {
          "type": "string",
          "pattern": "^UC[A-Za-z0-9_-]{22}$"
        },
        "transport": {
          "enum": [
            "api",
            "official-feed"
          ]
        },
        "trustTier": {
          "enum": [
            "first-party",
            "curated"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "cadence": {
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "quarterly"
          ]
        },
        "ownerLabel": {
          "type": "string",
          "minLength": 1
        },
        "includeRules": {
          "$ref": "#/$defs/commonStringArray"
        },
        "excludeRules": {
          "$ref": "#/$defs/commonStringArray"
        }
      }
    },
    "youtubePlaylist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "endpoint",
        "playlistId",
        "trustTier",
        "enabled",
        "cadence",
        "ownerLabel",
        "includeRules",
        "excludeRules"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "type": {
          "const": "youtube-playlist"
        },
        "endpoint": {
          "const": "https://youtube.googleapis.com/youtube/v3"
        },
        "playlistId": {
          "type": "string",
          "pattern": "^PL(?:[A-Za-z0-9_-]{16}|[A-Za-z0-9_-]{32})$"
        },
        "trustTier": {
          "const": "first-party"
        },
        "enabled": {
          "type": "boolean"
        },
        "cadence": {
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "quarterly"
          ]
        },
        "ownerLabel": {
          "type": "string",
          "minLength": 1
        },
        "includeRules": {
          "$ref": "#/$defs/commonStringArray"
        },
        "excludeRules": {
          "$ref": "#/$defs/commonStringArray"
        }
      }
    }
  }
}