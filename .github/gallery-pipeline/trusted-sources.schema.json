{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gallery trusted source registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "sources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sources": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/githubOrganization"
          },
          {
            "$ref": "#/$defs/documentationRoot"
          },
          {
            "$ref": "#/$defs/rssFeed"
          }
        ]
      }
    }
  },
  "$defs": {
    "commonStringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "githubOrganization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "endpoint",
        "organization",
        "trustTier",
        "enabled",
        "cadence",
        "ownerLabel",
        "includeRules",
        "excludeRules"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "type": {
          "const": "github-organization"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://api\\.github\\.com/orgs/[^/]+$"
        },
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "trustTier": {
          "const": "first-party"
        },
        "enabled": {
          "type": "boolean"
        },
        "cadence": {
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "quarterly"
          ]
        },
        "ownerLabel": {
          "type": "string",
          "minLength": 1
        },
        "includeRules": {
          "$ref": "#/$defs/commonStringArray"
        },
        "excludeRules": {
          "$ref": "#/$defs/commonStringArray"
        }
      }
    },
    "documentationRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "endpoint",
        "trustTier",
        "enabled",
        "cadence",
        "ownerLabel",
        "includeRules",
        "excludeRules"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "type": {
          "const": "documentation-root"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://learn\\.microsoft\\.com/"
        },
        "trustTier": {
          "const": "first-party"
        },
        "enabled": {
          "type": "boolean"
        },
        "cadence": {
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "quarterly"
          ]
        },
        "ownerLabel": {
          "type": "string",
          "minLength": 1
        },
        "includeRules": {
          "$ref": "#/$defs/commonStringArray"
        },
        "excludeRules": {
          "$ref": "#/$defs/commonStringArray"
        }
      }
    },
    "rssFeed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "endpoint",
        "trustTier",
        "enabled",
        "cadence",
        "ownerLabel",
        "includeRules",
        "excludeRules"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "type": {
          "const": "rss-feed"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://devblogs\\.microsoft\\.com/"
        },
        "trustTier": {
          "const": "first-party"
        },
        "enabled": {
          "type": "boolean"
        },
        "cadence": {
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "quarterly"
          ]
        },
        "ownerLabel": {
          "type": "string",
          "minLength": 1
        },
        "includeRules": {
          "$ref": "#/$defs/commonStringArray"
        },
        "excludeRules": {
          "$ref": "#/$defs/commonStringArray"
        }
      }
    }
  }
}