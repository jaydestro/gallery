{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gallery-cosmos:schema:public-catalog:1.0.0",
  "title": "Gallery public catalog document",
  "oneOf": [
    { "$ref": "#/$defs/publicItem" },
    { "$ref": "#/$defs/activeSnapshot" }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "catalogId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "publicItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "catalogId",
        "type",
        "schemaVersion",
        "catalogPartition",
        "snapshotId",
        "publicationStatus",
        "displayOrder",
        "title",
        "summary",
        "preview",
        "launchUrl",
        "canonicalSource",
        "sourceType",
        "author",
        "sourceOwner",
        "website",
        "tags",
        "publishedAt",
        "dateAdded",
        "lastVerified",
        "lifecycleStatus",
        "operationId",
        "sourceItemHash"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 1023, "pattern": "^[^/\\\\?#]+$" },
        "catalogId": { "$ref": "#/$defs/catalogId" },
        "type": { "const": "catalog-item" },
        "schemaVersion": { "const": "2.0.0" },
        "catalogPartition": { "const": "gallery" },
        "snapshotId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
        "publicationStatus": { "const": "published" },
        "displayOrder": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "preview": { "type": "string", "minLength": 1 },
        "launchUrl": { "type": "string", "format": "uri" },
        "canonicalSource": { "type": "string", "format": "uri" },
        "sourceType": {
          "enum": ["github-repository", "github-path", "learn-document", "blog-post", "video", "tool", "other"]
        },
        "author": { "type": "string", "minLength": 1 },
        "sourceOwner": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "website": { "type": "string", "format": "uri" },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "publishedAt": {
          "oneOf": [
            { "type": "string", "format": "date" },
            { "type": "string", "format": "date-time" }
          ]
        },
        "dateAdded": {
          "oneOf": [
            { "type": "string", "format": "date" },
            { "type": "null" }
          ]
        },
        "lastVerified": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "lifecycleStatus": { "enum": ["active", "needs-review"] },
        "supersededBy": {
          "oneOf": [
            { "$ref": "#/$defs/catalogId" },
            { "type": "null" }
          ]
        },
        "operationId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sourceItemHash": { "$ref": "#/$defs/hash" }
      }
    },
    "activeSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "schemaVersion",
        "catalogPartition",
        "snapshotId",
        "itemCount",
        "catalogHash",
        "operationId",
        "publishedAt"
      ],
      "properties": {
        "id": { "const": "active-snapshot" },
        "type": { "const": "active-snapshot" },
        "schemaVersion": { "const": "1.0.0" },
        "catalogPartition": { "const": "gallery" },
        "snapshotId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
        "itemCount": { "type": "integer", "minimum": 0 },
        "catalogHash": { "$ref": "#/$defs/hash" },
        "operationId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}